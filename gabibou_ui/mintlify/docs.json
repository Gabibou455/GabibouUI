{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gabibou UI",
  "description": "Documentation française de Gabibou UI : exemple complet, composants, mobile et référence API.",
  "colors": {
    "primary": "#737373",
    "light": "#D4D4D8",
    "dark": "#A1A1AA"
  },
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Commencer",
            "pages": [
              "index",
              "getting-started/quickstart",
              "examples/quickstart"
            ]
          },
          {
            "group": "Construire son interface",
            "pages": [
              "customization/controls",
              "customization/appearance-and-layout",
              "customization/values-and-config",
              "guide/notifications-commandes",
              "guide/chargement-acces",
              "guide/depannage"
            ]
          }
        ]
      },
      {
        "tab": "Référence",
        "pages": [
          "reference/api",
          "reference/customization",
          "reference/icon-catalogue"
        ]
      },
      {
        "tab": "Avancé",
        "groups": [
          {
            "group": "Installation et design",
            "pages": [
              "getting-started/installation",
              "customization/design-your-interface",
              "customization/icons-and-branding"
            ]
          },
          {
            "group": "Flux spécialisés",
            "pages": [
              "customization/commands-and-presets",
              "customization/loading-screens",
              "customization/key-systems",
              "customization/events-and-lifecycle",
              "customization/animations-and-components",
              "customization/notifications"
            ]
          },
          {
            "group": "Exemples détaillés",
            "pages": [
              "examples/loading",
              "examples/discord-prompt",
              "examples/key-discord",
              "examples/key-providers",
              "examples/key-external-server",
              "examples/server-validation",
              "examples/remote-loading"
            ]
          },
          {
            "group": "IA et vérification",
            "pages": [
              "getting-started/use-with-ai",
              "ai/agent-guide",
              "reference/quality"
            ]
          }
        ]
      }
    ]
  }
}
